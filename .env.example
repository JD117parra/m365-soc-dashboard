# ─────────────────────────────────────────────────────────────────────────────
# Backend — Go server (server/.env or exported in your shell)
# ─────────────────────────────────────────────────────────────────────────────

# Azure AD tenant ID (e.g. xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx)
TENANT_ID=your-tenant-id

# Azure AD App Registration client ID
CLIENT_ID=your-client-id

# Azure AD App Registration client secret
CLIENT_SECRET=your-client-secret

# Port for the Go HTTP server (default: 8080)
PORT=8080

# ─────────────────────────────────────────────────────────────────────────────
# Frontend — Vite (client/.env)
# All VITE_ prefixed variables are exposed to the browser bundle
# ─────────────────────────────────────────────────────────────────────────────

# Azure AD tenant ID (same value as TENANT_ID above)
VITE_TENANT_ID=your-tenant-id

# Azure AD App Registration client ID (same value as CLIENT_ID above)
VITE_CLIENT_ID=your-client-id

# OAuth redirect URI — must match an entry in your App Registration
VITE_REDIRECT_URI=http://localhost:5173
